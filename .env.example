# Скопируйте в `.env`. Подхватывается через dotenvy при старте; аргументы CLI важнее переменных.
# Разработка: обычно корень репозитория (cwd при `cargo run`).
# Портативная установка: `.env` рядом с exe; на Windows все `*.dll` из vosk-lib должны быть и в каталоге с exe (загрузчик до main). install-release.ps1 копирует их автоматически; подкаталог vosk-lib + PATH/LD_LIBRARY_PATH — дополнительно.
#
# Префикс LOCALVOX_LIGHT_* чтобы не пересекаться с сервером / client-reliable.

# ── Модель Vosk (дефолт = каталог из setup-vosk: models/vosk-model-ru-0.42) ──
# Первичная установка: ./scripts/setup-vosk.sh … или scripts\setup-vosk.ps1 → models/ и vosk-lib/
# Windows: лучше без кавычек и со слэшами / (в кавычках F:\vosk\... — \v может стать escape в .env)
# LOCALVOX_LIGHT_MODEL=models/vosk-model-ru-0.42

# ── Устройства (перекрывают localvox-light-config.json, см. LOCALVOX_LIGHT_CONFIG) ──
# LOCALVOX_LIGHT_MIC=default
# LOCALVOX_LIGHT_LOOPBACK_DEVICE=default-output
# LOCALVOX_LIGHT_CONFIG=./localvox-light-config.json

# ── Рабочий каталог (wav + transcript.jsonl в корне; без вложенных session_*) ──
LOCALVOX_LIGHT_AUDIO_DIR=localvox-audio

# Каталог для экспорта по [e] в TUI: transcript_dump_*.jsonl (строки по времени + seg, не порядок ASR). Пустое — экспорт отключён.
LOCALVOX_LIGHT_TRANSCRIPT_DUMP_DIR=./transcript-dumps

# ── Сегментация / VAD / шум ──
LOCALVOX_LIGHT_MAX_CHUNK_SEC=10
LOCALVOX_LIGHT_MIN_CHUNK_SEC=1.5
LOCALVOX_LIGHT_VAD_SILENCE_SEC=0.8
LOCALVOX_LIGHT_NOISE_GATE=0.15

# ── ASR ──
LOCALVOX_LIGHT_ASR_WORKERS=2
# Legacy: fast-lane сегменты на диск, как до WP-B1 (по умолчанию — в RAM:
# очереди WAV-файлов больше нет, durability обеспечивают чанки сессии)
# LOCALVOX_LIGHT_SEGMENTS_DISK=1

# ── Чанки сессии (F8): непрерывная запись аудио — первичный артефакт для «варки» ──
# Пишутся в <AUDIO_DIR>/sessions/<дата_время>/audio, ротация на VAD-тишине.
# Отключить: LOCALVOX_LIGHT_NO_SESSION_CHUNKS=1 или --no-session-chunks
# LOCALVOX_LIGHT_NO_SESSION_CHUNKS=1
# Длительность чанка, сек (ротация файла; соседние чанки склеиваются сэмпл-в-сэмпл,
# граница может пройти посреди слова — окна ASR нарезаются по тишине на чтении)
# LOCALVOX_LIGHT_CHUNK_SEC=300
# Retention аудио-чанков, дней; 0 — хранить вечно. Транскрипты не удаляются никогда.
# LOCALVOX_LIGHT_RETENTION_AUDIO_DAYS=14
# Пережимать закрытые чанки WAV → FLAC (нужен ffmpeg: PATH или LOCALVOX_LIGHT_YT_FFMPEG)
# LOCALVOX_LIGHT_CHUNK_FLAC=1

# ── Режимы (1 / true / yes / on — включить; иначе выкл.) ──
# В интерактивном терминале TUI включается сам, если LOCALVOX_LIGHT_TUI не задан в окружении.
# LOCALVOX_LIGHT_TUI=1
# Только логи в stderr, без TUI (перекрывает авто-TUI): LOCALVOX_LIGHT_NO_TUI=1 или флаг --no-tui
# LOCALVOX_LIGHT_NO_TUI=1
# Подробные строки этапов в панели TUI (segment / gate / asr / load …); без этого — только ошибки в панели.
# LOCALVOX_LIGHT_VERBOSE=1
# Подробный stderr (tracing); не путать с VERBOSE.
# LOCALVOX_LIGHT_DEBUG=1
# LOCALVOX_LIGHT_LOOPBACK=1
# LOCALVOX_LIGHT_NO_LOOPBACK=1
# LOCALVOX_LIGHT_LIST_DEVICES=1

# ── localvox-youtube (cargo run -p localvox-light-youtube): URL (yt-dlp) или --file (только ffmpeg) + Vosk ──
# Приоритет: аргументы CLI → переменные ниже → settings.json / localvox-youtube-settings.json → поиск в cwd и рядом с exe.
# yt-dlp не нужен, если запуск только с --file / -f (локальный mp4 и т.д.).
# Windows: без кавычек, пути лучше через / (см. комментарий к LOCALVOX_LIGHT_MODEL).
# LOCALVOX_LIGHT_YT_DLP=youtube-transcribe/yt-dlp.exe
# LOCALVOX_LIGHT_YT_FFMPEG=F:/ffmpeg7.1.1/bin/ffmpeg.exe
# LOCALVOX_LIGHT_YT_JS_RUNTIME=node
# LOCALVOX_LIGHT_YT_JS_RUNTIME_PATH=F:/nodejs/node.exe
# Каталог по умолчанию: один источник (URL или --file) → transcript.txt внутри него; несколько → transcript_001.txt … (вместо ./youtube-transcripts).
# LOCALVOX_LIGHT_YOUTUBE_OUTPUT_DIR=transcripts

# ── Надёжность захвата (F9) ──
# Запасные микрофоны (через запятую), если основной пропал/недоступен
# LOCALVOX_LIGHT_MIC_FALLBACKS=USB Microphone,default
# Watchdog: предупреждение в статусе, если микрофон молчит дольше N сек (0 — выкл)
# LOCALVOX_LIGHT_MIC_SILENCE_WARN_SEC=15

# ── Семантический поиск (WP-C11; веб-селектор «по смыслу», localvox-search --semantic) ──
#
# Модель эмбеддингов в Ollama:  ollama pull bge-m3
#
# ПОЧЕМУ bge-m3, А НЕ nomic-embed-text — ЗАМЕРЕНО на живом архиве (13.07.2026).
# Владелец искал «капрезе» — слова, которого в записях НЕТ ВООБЩЕ, — и получил пять
# уверенных результатов, все мусорные. Причина не в отсутствии порога, а в том, что у
# nomic ПОРОГ СТАВИТЬ НЕ НА ЧТО:
#
#   запрос              есть в архиве?   nomic топ-1   bge-m3 топ-1
#   «капрезе»           НЕТ              0.830         0.424
#   «квартальный…»      НЕТ              0.851         0.444
#   «курица»            ДА               0.765         0.634
#
# У nomic МУСОР РАНЖИРУЕТСЯ ВЫШЕ верного попадания: его косинусы зажаты в узкую полосу
# и на русском не несут сигнала. У bge-m3 мусор 0.42–0.56, верное 0.58–0.63 — между ними
# есть зазор, и порог наконец имеет смысл.
#
# LOCALVOX_EMBED_MODEL=bge-m3
# LOCALVOX_EMBED_BASE_URL=http://localhost:11434
# LOCALVOX_EMBED_TIMEOUT_SEC=60
#
# ПОРОГ ОТСЕЧЕНИЯ: ниже него — не «слабое совпадение», а НЕ СОВПАДЕНИЕ.
# Без него семантика всегда возвращает top-k ближайших векторов, даже когда в архиве нет
# ничего похожего, — и превращается в генератор уверенной чепухи. «Ничего не нашлось» —
# полноценный ответ.
#
# Число ЗАВИСИТ ОТ МОДЕЛИ: сменили модель — порог надо ПЕРЕМЕРИТЬ, а не угадать.
# Похожесть каждого результата видна в выдаче — по ней и настраивайте.
# LOCALVOX_SEARCH_MIN_SIMILARITY=0.55

# ── F5-роутинг «куда занести» (кнопка 🧭 в веб-архиве, POST /api/route) ──
# Таймаут LLM-подсказки слота (короткий — интерактив, не батч)
# LOCALVOX_LLM_ROUTE_TIMEOUT_SEC=30

# ── HTTP API + веб-архив (демон --tray; или бинарь localvox-api) ──
# LOCALVOX_API_BIND=127.0.0.1:3017     # 0.0.0.0:3017 — доступ с телефона (нужен токен!)
# LOCALVOX_API_TOKEN=                  # обязателен при не-localhost bind
# Веб-страница архива: http://<bind>/ (поиск, сессии, заметки)

# ── Автоварка (WP-C7, демон --tray) ──
# Выключить: LOCALVOX_LIGHT_AUTOCOOK=off
# LOCALVOX_LIGHT_AUTOCOOK_INTERVAL_SEC=300   # как часто искать недоваренное
# LOCALVOX_LIGHT_AUTOCOOK_QUIESCENT_SEC=60   # сессия «тихая» столько сек → варим
# LOCALVOX_LIGHT_AUTOCOOK_SUMMARY=1          # заодно протокол через LLM (нужна ollama)
# LOCALVOX_LIGHT_AUTOCOOK_CLEANUP=1          # заодно причёсанный транскрипт
# LOCALVOX_LIGHT_AUTOCOOK_REFINE=1           # заодно refined-версия (LLM, best переключается)
# Здесь была переварка архива при смене «рецепта» (LOCALVOX_LIGHT_AUTOCOOK_RECOOK_STALE).
# Её больше нет и не будет. Рецепт менялся сам собой — правка промпта, модель в .env,
# язык, даже рабочий каталог, — и каждый раз архив втихую переваривался целиком.
# Сделанное сделано: улучшение движка доезжает до старых записей тогда, когда человек
# нажал «переварить», и только тогда.

# ── Запись (WP-C60) ──
# Запись НЕ идёт по умолчанию. Звук слушается всегда, но на диск не попадает ничего,
# пока человек не скажет: диктофон, работающий весь день в офисе, пишет чужие
# разговоры, на которые никто не соглашался.
#
# Кнопку делает безопасной кольцевой буфер: последние N секунд держатся в ПАМЯТИ и
# входят в сессию в момент нажатия — разговор, начавшийся до кнопки, не потерян.
# 5 минут двух дорожек ≈ 19 МБ.
# LOCALVOX_LIGHT_PREROLL_SEC=300
# Тишина на обеих дорожках дольше N сек закрывает запись сама (0 — никогда).
# LOCALVOX_LIGHT_AUTOSTOP_SEC=900

# ── Детект звонков (F3, Windows) ──
# Выключить: LOCALVOX_LIGHT_CALL_DETECT=off
# LOCALVOX_LIGHT_CALL_DETECT=off
# Не считать звонком эти приложения (exe через запятую)
# LOCALVOX_LIGHT_CALL_IGNORE=obs64.exe,audacity.exe

# ── Голосовой модуль (F2): «запиши [в слот X] …» → заметка в слот + TTS-ответ ──
# Активен, если найден slots.toml (см. slots.example.toml и docs/integrations.md).
# Команды слушаются ТОЛЬКО с микрофона. Выключить: LOCALVOX_LIGHT_VOICE=off
# LOCALVOX_LIGHT_VOICE=off
# Командное слово (первое слово фразы)
# LOCALVOX_LIGHT_VOICE_TRIGGER=запиши
# Проговаривать ли записанное (off — тихий режим)
# LOCALVOX_LIGHT_VOICE_CONFIRM=off
# Конец заметки: тишина N сек (заметка копится через паузы многими фразами)
# LOCALVOX_LIGHT_NOTE_IDLE_SEC=3.5
# Стоп-фразы (сказанные отдельной фразой, закрывают заметку; через запятую)
# LOCALVOX_LIGHT_NOTE_STOP_WORDS=всё,конец,стоп,хватит,конец записи
# Ретро-режим «запиши это»: сколько последних секунд разговора забирать
# LOCALVOX_LIGHT_RETRO_WINDOW_SEC=30
# Конфиг слотов (по умолчанию ./slots.toml)
# LOCALVOX_SLOTS_CONFIG=./slots.toml
# TTS: sapi (Windows, без зависимостей) | piper (лучше звучит, нужен exe+модель) | off
# LOCALVOX_LIGHT_TTS=sapi
# LOCALVOX_LIGHT_PIPER=D:/tools/piper/piper.exe
# LOCALVOX_LIGHT_PIPER_MODEL=D:/tools/piper/ru_RU-irina-medium.onnx

# ── LLM (localvox-process --summary / --cleanup): Ollama / OpenAI / OpenRouter ──
# База OpenAI-compat; для :11434 автоматически используется нативный диалект Ollama
# (там честно отключается thinking у Qwen3/3.5).
# LOCALVOX_LLM_BASE_URL=http://localhost:11434/v1
# Модель для причёсывания и протокола. Замерено 13.07.2026 на реальной записи:
# qwen3.5:9b сохраняет структуру реплик и таймкоды один в один; qwen3.5:4b
# СКЛЕИВАЕТ соседние реплики (таймкоды теряются); granite4.1:8b склеивает и
# опечатывается, а на протоколах ещё и отказывается разбирать реальную запись
# (docs/asr-bench.md).
# LOCALVOX_LLM_MODEL=qwen3.5:9b
# Имя env-переменной с ключом (для облака): например OPENAI_API_KEY / OPENROUTER_API_KEY
# LOCALVOX_LLM_API_KEY_ENV=OPENAI_API_KEY
# LOCALVOX_LLM_GLOSSARY_DIR=assets/glossary
# LOCALVOX_LLM_TEMPLATES_DIR=templates
# Шаблон протокола. По умолчанию — по языку записи и её длине (для короткой
# записи — заметка, а не протокол с пустыми «Поручениями»). Задавайте, только
# если хотите ОДИН шаблон на всё: video-notes-ru (конспект видео) или свой.
# LOCALVOX_LLM_SUMMARY_TEMPLATE=video-notes-ru

# ── Язык записи ──
# По умолчанию — «auto»: распознаём моделью языка по умолчанию (русской), а язык
# ТЕКСТА определяем по самой расшифровке — им выбираются шаблоны и язык ответа LLM.
#
# Почему авто не выбирает ASR-модель: язык определяется по тексту, а текст выдаёт
# модель — которую ещё надо выбрать. Английскую речь русская модель не «не
# распознает», а выдаст правдоподобную русскую кашу, и любой детектор честно
# скажет «это русский». Поэтому, чтобы РАСПОЗНАТЬ другой язык, его надо назвать.
#
# Язык входит в РЕЦЕПТ варки и LLM-артефактов: смените его — и расшифровка с
# протоколом станут «сделанными не так», а значит будут сделаны заново. Отдельной
# кнопки «сбросить производное» нет, потому что она не нужна.
# LOCALVOX_LANG=auto
#
# Модель для не-дефолтного языка: положите её в models/asr-<язык> или укажите
# путь. Подойдёт ONNX-модель (*.onnx) или модель Vosk (каталог с am/, conf/) —
# что лежит, то и опознаем. Модели для языка нет — варка падает громко, а не
# варит русской моделью молча.
# LOCALVOX_ASR_MODEL_DIR_EN=models/vosk-model-small-en-us-0.15

# ── Проверка имён: NER-модель (опционально, но очень желательно) ──
# Проверка обоснованности не даёт LLM выдать за факт то, чего в записи не было.
# ЧИСЛА она проверяет всегда и детерминированно — правилами, без всякой модели.
# А вот ЛЮДЕЙ («Иван подготовит отчёт», «Marcus will ship it») размечает NER-модель.
#
# Почему модель, а не список имён: имён в языке бесконечно много, и главное —
# список не видит контекста, поэтому НИКОГДА не снимет омонимию. Замерено:
#   «Роман закроет задачу»  → человек 0.89
#   «надо дописать роман»   → человека нет вовсе
# Списком эти два «романа» неразличимы.
#
# Это НЕ «модель проверяет модель»: GLiNER — энкодер, он размечает СПАНЫ ВХОДА и
# выдумать имя физически не может (у него нет декодера).
#
# Модель: onnx-community/gliner_multi-v2.1 (Apache-2.0), кладётся в models/ner-gliner:
#   model_fp16.onnx (580 МБ, лучшая калибровка) ЛИБО model_q4f16.onnx (472 МБ, вдвое быстрее)
#   tokenizer.json, gliner_config.json
#
# ВНИМАНИЕ: int8-версию НЕ БРАТЬ. У mDeBERTa она разваливает калибровку — измерено:
# «Роман» 0.22 вместо 0.89, «Marcus» 0.17 вместо 0.97. При любом разумном пороге
# модель молча не находит НИЧЕГО, и это неотличимо от честной пустой записи.
#
# Нет модели — люди не проверяются, и варка говорит об этом вслух.
# LOCALVOX_NER_MODEL_DIR=models/ner-gliner
# LOCALVOX_NER_MODEL_FILE=model_fp16.onnx
# Порог уверенности для ОТВЕТА (запись читается щедрее — лишняя сущность там
# безвредна, она может только обосновать ответ).
# LOCALVOX_NER_THRESHOLD=0.5
# Метки — СТРОКАМИ (zero-shot). Их ДВЕ, и вторая не менее важна первой.
#
# Записи без единого имени существуют (голосовая заметка, монолог), и протокол
# обязан как-то назвать говорящего: «спикер», «говорящий», «рассказчик». Это РОЛЬ,
# а не человек. Без второй метки каждый честный протокол безымянной записи уезжал
# в карантин (приёмка 13.07.2026 на живом архиве).
#
# Спрашиваем ДВУМЯ НЕЗАВИСИМЫМИ проходами и сравниваем: имя обязано ПЕРЕВЕСИТЬ
# роль на том же спане. Замерено:
#   Говорящий   имя 0.53 < роль 0.79  → роль
#   Роман       имя 0.54 > роль 0.49  → ИМЯ (омонимия снята контекстом)
#   Marcus      имя 0.88 > роль 0.77  → ИМЯ
# Абсолютный порог для роли не годится: она срабатывает и на именах (Иван — 0.78).
# Значение имеет только ПОРЯДОК.
# LOCALVOX_NER_LABEL_NAME=имя человека
# LOCALVOX_NER_LABEL_ROLE=говорящий или роль

# ── Диаризация: КТО говорит (models/diarize; ставится scripts/setup-diarize.ps1) ──
#
# Без неё все собеседники созвона — один безликий «Собеседники»: они приходят
# одним смешанным потоком, и сводка не может честно написать «Иван взял миграцию».
#
# Две модели, обе обязательны и обе НЕ ГЕНЕРАТИВНЫЕ — они не пишут текст, а
# классифицируют вход, и выдумать человека, которого не было в звуке, не могут:
#   segmentation.onnx — pyannote segmentation-3.0 (MIT/CNRS): кто говорит в каждом
#                       кадре, включая ПЕРЕКРЫТИЕ речи;
#   embedding.onnx    — ERes2Net base 200k (Apache-2.0): вектор ГОЛОСА (тембр, а не
#                       слова: он языко-независим по природе).
#
# КВАНТОВАННЫЕ ВЕРСИИ НЕ БРАТЬ — измерено: int8-сегментация расходится с fp32 на 7 %
# кадров, размазывает границу реплики с 3.5 с до 6.6 с и выдумывает перекрытие речи;
# fp16 падает с segfault на CPU. У эмбеддера квантизация ломает косинусную геометрию
# — то самое, чем мы отличаем людей друг от друга.
#
# Нет моделей — говорящие не размечаются, и это ЧЕСТНЫЙ ответ: строки остаются с
# подписью источника («Я» / «Собеседники»), как раньше.
#
# Разметка входит в РЕЦЕПТ варки: поставили модели — архив доразметится сам, тем же
# механизмом миграции, что и при смене языка. Убрали — вернётся как было.
# LOCALVOX_DIARIZE=off             # выключить, не удаляя моделей
# LOCALVOX_DIARIZE_MODEL_DIR=models/diarize

# ── Лексикон: свои имена, аббревиатуры, числительные (assets/lexicon/README.md) ──
# Проверка обоснованности не даёт модели выдать за факт то, чего в записи не было.
# Чтобы она не ошибалась на ваших данных, дайте ей ваши словари: файлы *.toml из
