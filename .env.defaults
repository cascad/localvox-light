# Предустановки каталога. Пользовательские значения в .env имеют приоритет.
# Пустые пути/устройства означают автоматический выбор, пустой токен — не задан.
LOCALVOX_LIGHT_YT_DLP=
LOCALVOX_LIGHT_YT_FFMPEG=
LOCALVOX_LIGHT_YT_JS_RUNTIME_PATH=
LOCALVOX_LIGHT_MIC=
LOCALVOX_LIGHT_LOOPBACK_DEVICE=
LOCALVOX_LIGHT_PREROLL_SEC=300
LOCALVOX_LIGHT_CHUNK_SEC=300
LOCALVOX_LIGHT_AUTOSTOP_SEC=900
LOCALVOX_LLM_BASE_URL=http://localhost:11434/v1
LOCALVOX_LLM_MODEL=qwen3.5:9b
LOCALVOX_SUMMARY_PROVIDER=ollama
LOCALVOX_LLM_SERVER_URLS=["http://localhost:11434/v1"]
LOCALVOX_API_BIND=127.0.0.1:3017
LOCALVOX_API_TOKEN=
LOCALVOX_LIGHT_AUTOCOOK=on
LOCALVOX_LIGHT_AUTOCOOK_INTERVAL_SEC=5
LOCALVOX_LIGHT_AUTOCOOK_QUIESCENT_SEC=15
LOCALVOX_LIGHT_AUTOCOOK_SUMMARY=on
LOCALVOX_LANG=auto
